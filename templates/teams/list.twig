{% extends "layout.twig" %}
{% block content %}
<div class="container mt-5">
    <h3 class="mb-4">Team List</h3>
    <a href="/teams/create" class="btn btn-primary mb-3">+ Add Team</a>

    <table class="table table-custom">
        <thead>
            <tr>
                <th>#</th>
                <th>Team Name</th>
                <th>Description</th>
                <th>Created At</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for team in teams %}
            <tr>
                <td>{{ loop.index }}</td>
                <td>{{ team.name }}</td>
                <td>{{ team.description }}</td>
                <td>{{ team.created_at }}</td>
                <td>
                    <a href="/teams/edit/{{ team.id }}" class="btn btn-warning btn-sm">Edit</a>
                    <a href="/teams/delete/{{ team.id }}" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure?')">Delete</a>
                    <a href="/teams/{{ team.id }}/members" class="btn btn-info btn-sm">Members</a>
                </td>
            </tr>
            {% else %}
            <tr><td colspan="5" class="text-center">No teams found.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
