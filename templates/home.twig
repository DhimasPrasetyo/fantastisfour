<!-- Hero Section -->
<section id="hero" class="py-5 text-white" style="min-height: 100vh; display: flex; align-items: center; background-color: #a78bfa;">
    <div class="container">
        <div class="row align-items-center">
            <!-- Teks di Kiri -->
            <div class="col-md-6">
                <small class="text-uppercase text-warning fw-bold">Solusi Tepat untuk Produktivitas</small>
                <h1 class="display-4 fw-bold mt-3">Kelola Tugas Tim Lebih Mudah<br>bersama <span class="text-warning">Fantastic Four</span></h1>
                <p class="lead mt-3">Platform manajemen tugas yang dirancang untuk memudahkan koordinasi, memantau progres, dan meningkatkan kolaborasi dalam satu sistem yang efisien.</p>
                <a href="#about" class="btn btn-light btn-lg mt-3">Pelajari Lebih Lanjut</a>
            </div>

            <!-- Gambar di Kanan -->
            <div class="col-md-6 text-center">
                <img src="https://cdn-icons-png.flaticon.com/512/3043/3043453.png" alt="Ilustrasi Manajemen Tugas" class="img-fluid" style="max-height: 400px;">
            </div>
        </div>
    </div>
</section>

<!-- About Section -->
<section id="about" class="py-5 bg-light">
