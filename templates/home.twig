                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#q1">Bagaimana cara membuat tugas baru?</button>
                </h2>
                <div id="q1" class="accordion-collapse collapse show">
                    <div class="accordion-body">Klik tombol "Tugas Baru" di dashboard untuk memulai.</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#q2">Apakah saya bisa melacak progres secara real-time?</button>
                </h2>
                <div id="q2" class="accordion-collapse collapse">
                    <div class="accordion-body">Ya, melalui dashboard pelacakan progres langsung.</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#q3">Apakah tersedia aplikasi mobile?</button>
                </h2>
                <div id="q3" class="accordion-collapse collapse">
                    <div class="accordion-body">Tersedia untuk platform iOS dan Android.</div>
                </div>
            </div>
        </div>
    </div>
</section>

