<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Sidebar Scrollable</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    /* Tambahan agar sidebar bisa discroll */
    aside.bg-dark {
      position: fixed;
      top: 0;
      left: 0;
      height: 100vh;
      overflow-y: auto;
      z-index: 1030;
    }

    /* Responsive: agar di mobile sidebar tidak fixed */
    @media (max-width: 768px) {
      aside.bg-dark {
        position: relative;
        height: auto;
        max-height: 100vh;
      }
    }
  </style>
</head>
<body>

  <!-- Sidebar asli (tidak diubah) -->
  <aside class="bg-dark text-white p-3" style="width: 260px; min-height: 100vh; flex-shrink: 0;">
      <h4 class="text-white mb-4 d-flex align-items-center">
          <i class="bi bi-stars me-2"></i>Fantastic Four
      </h4>
      <ul class="nav flex-column small">
          <li class="nav-item mb-2">
              <a class="nav-link text-white d-flex justify-content-between align-items-center" href="/dashboard">
                  <span><i class="bi bi-grid-fill me-2"></i>Dashboards</span>
                  <span class="badge bg-secondary rounded-pill">12</span>
              </a>
          </li>

          <li class="nav-item mb-2">
              <a class="nav-link text-white" href="#">
                  <i class="bi bi-file-earmark-text me-2"></i>Pages <span class="badge bg-info ms-2">New</span>
              </a>
          </li>

          <li class="nav-item mb-2">
              <a class="nav-link text-white d-flex justify-content-between align-items-center" data-bs-toggle="collapse" href="#taskMenu" role="button">
                  <span><i class="bi bi-list-task me-2"></i>Task</span>
                  <i class="bi bi-chevron-down small"></i>
              </a>
              <div class="collapse ps-3" id="taskMenu">
                  <a class="nav-link text-white" href="#">Kanban Board</a>
                  <a class="nav-link text-white" href="#">List View</a>
                  <a class="nav-link text-white" href="#">Task Details</a>
              </div>
          </li>

          <li class="nav-item mb-2">
              <a class="nav-link text-white" href="#"><i class="bi bi-person-check me-2"></i>Authentication</a>
          </li>

          <li class="nav-item mb-2">
              <a class="nav-link text-white" href="#"><i class="bi bi-exclamation-triangle me-2"></i>Error</a>
          </li>

          <li class="nav-item mt-4 text-uppercase text-muted small">General</li>

          <li class="nav-item mb-2">
              <a class="nav-link text-white" href="#"><i class="bi bi-brush me-2"></i>UI Elements</a>
          </li>

          <li class="nav-item mb-2">
              <a class="nav-link text-white" href="#"><i class="bi bi-tools me-2"></i>Utilities</a>
          </li>

          <li class="nav-item mb-2">
              <a class="nav-link text-white" href="#"><i class="bi bi-journal-text me-2"></i>Forms</a>
          </li>

          <li class="nav-item mb-2">
              <a class="nav-link text-white" href="#"><i class="bi bi-layers me-2"></i>Advanced UI</a>
          </li>

          <li class="nav-item mb-2">
              <a class="nav-link text-white" href="#"><i class="bi bi-box me-2"></i>Widgets <span class="badge bg-danger ms-2">Hot</span></a>
          </li>

          <li class="nav-item mt-4 text-uppercase text-muted small">Web Apps</li>

          <li class="nav-item mb-2">
              <a class="nav-link text-white" href="#"><i class="bi bi-globe me-2"></i>Apps</a>
          </li>

          <li class="nav-item">
              <a class="nav-link text-white" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a>
          </li>
      </ul>
  </aside>

  <!-- Bootstrap JS (untuk collapse) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
