{% extends 'layout.twig' %}

{% block content %}
<div class="container">
    <h4 class="mb-4">Detail Task</h4>

    <div class="card p-4">
        <h5>{{ task.title }}</h5>
        <p>{{ task.description }}</p>

        <hr>

        <p><strong>Status:</strong> {{ task.status }}</p>
        <p><strong>Tanggal Dibuat:</strong> {{ task.created_at }}</p>
        <p><strong>Deadline:</strong> {{ task.deadline }}</p>
        <p><strong>Tags:</strong>
            {% for tag in task.tags %}
                <span class="badge bg-secondary">{{ tag }}</span>
            {% endfor %}
        </p>
        <p><strong>Likes:</strong> {{ task.likes }}, <strong>Comments:</strong> {{ task.comments }}</p>
        <p><strong>Anggota:</strong> <img src="/img/user1.jpg" class="rounded-circle" width="24" height="24"></p>

        <a href="/dashboard" class="btn btn-secondary mt-3">← Kembali ke Dashboard</a>
    </div>
</div>
{% endblock %}
